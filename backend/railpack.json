{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "buildAptPackages": [],
  "steps": {
    "install": {
      "commands": [
        "pip install --no-cache-dir -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
